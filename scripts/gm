#!/usr/bin/env bash
# Launch the GM: validate the league, assemble the GM's instructions in private/, start Codex there.
#
#   scripts/gm                   interactive GM session
#   scripts/gm ask "question"    one non-interactive turn; answer saved under private/reports/
#
# Environment: FF_GM_MODEL (default gpt-6-sol), FF_GM_EFFORT (default high).
set -euo pipefail

repo="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# One absolute path shared with ff (Codex runs from inside it, so relative paths would break).
private="$(realpath -m "${FF_PRIVATE_DIR:-$repo/private}")"
export FF_PRIVATE_DIR="$private"
export PATH="$repo/bin:$PATH"
model="${FF_GM_MODEL:-gpt-6-sol}"
effort="${FF_GM_EFFORT:-high}"

# 1. Fail closed: no validated league context, no GM.
if ! ff context >/dev/null; then
  echo "GM not started: league validation failed (details above)." >&2
  exit 1
fi

# 2. The private workspace is its own git repository, so Codex treats it as the project root and
#    does not load the public repository's engineering AGENTS.md.
mkdir -p "$private/notes" "$private/reports"
if [[ ! -d "$private/.git" ]]; then
  git -C "$private" init -q
fi
seed() { [[ -f "$private/notes/$1" ]] || printf '%s\n' "$2" >"$private/notes/$1"; }
seed strategy.md "# Franchise strategy

Direction (contend / retool / rebuild): _not yet set — ask the Owner._

## Owner preferences and mandates
"
seed managers.md "# Manager notes

One section per manager. Keep observed facts (dated, with transaction evidence) separate from inferred tendencies (with confidence).
"
seed recommendations.md "# Recommendation log

Append-only. Date · constitution hash · recommendation · key reasoning · confidence and uncertainty · Owner decision.
"

# 3. Instructions: stable charter first, then the freshly validated constitution.
{
  echo "<!-- Generated by scripts/gm from gm/CHARTER.md and the validated constitution. Edit gm/CHARTER.md instead. -->"
  echo
  cat "$repo/gm/CHARTER.md"
  echo
  echo "---"
  echo
  cat "$private/LEAGUE_CONSTITUTION.md"
} >"$private/AGENTS.md"

# 4. Codex: writes limited to private/ (plus the ff cache), network on for ff, live web search.
common=(
  -C "$private"
  -m "$model"
  -c "model_reasoning_effort=\"$effort\""
  -c 'web_search="live"'
  -s workspace-write
  -c 'sandbox_workspace_write.network_access=true'
  --add-dir "$repo/.local"
)

# Briefs are versioned prompts in gm/briefs/ (war-room, recap, lineup, daily).
label=""
if [[ "${1:-}" == "brief" ]]; then
  brief="$repo/gm/briefs/${2:-}.md"
  if [[ -z "${2:-}" || ! -f "$brief" ]]; then
    echo "Usage: scripts/gm brief <$(ls "$repo/gm/briefs" | sed 's/\.md$//' | paste -sd'|')>" >&2
    exit 2
  fi
  label="-$2"
  set -- ask "$(cat "$brief")"
fi

if [[ "${1:-}" == "ask" ]]; then
  shift
  [[ $# -gt 0 ]] || { echo 'Usage: scripts/gm ask "question"' >&2; exit 2; }
  stamp="$(date +%Y-%m-%d-%H%M%S)"
  out="$private/reports/$stamp$label.md"
  codex exec "${common[@]}" -o "$out" "$*"
  echo "Saved: $out" >&2
else
  exec codex "${common[@]}" "$@"
fi
